# Environment
NODE_ENV=development

# Server API
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowboard?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flowboard
POSTGRES_PORT=5432

# Redis Cache & Realtime Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=flowboard_dev_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=flowboard_dev_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
